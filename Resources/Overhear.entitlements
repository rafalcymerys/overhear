<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime, which notarization requires, blocks the
         microphone unless this is granted. Nothing else needs an entitlement:
         the app is not sandboxed, and the accessibility access TextInjector
         relies on is a TCC grant rather than an entitlement. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
